    },
    "NSAudioCaptureUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirIsland captures the current player's audio to display a live music spectrum. Audio is analyzed on this Mac and is never saved or uploaded."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirIsland 需要采集当前播放器输出的声音，以显示实时音乐频谱。音频仅在本机分析，不会保存或上传。"
          }
        }
      }
    }
  },
  "version" : "1.0"
